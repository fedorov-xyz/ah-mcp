# ah-mcp configuration. Copy to .env and fill in; never commit .env.

# Public origin of this server (no trailing slash, no path). Must be https://,
# except 127.0.0.1/localhost for local development — use http://127.0.0.1:3000,
# not localhost: AH's login page uses hCaptcha, which rejects the host
# "localhost". All OAuth/metadata URLs are
# built from this value, never from Host / X-Forwarded-* headers.
AH_MCP_BASE_URL=https://ah-mcp.example.com

# Secret used to seal client IDs and tokens. base64, >= 32 bytes decoded.
# Generate one with:
#   openssl rand -base64 32
# Changing it logs everyone out (clients must reconnect).
AH_MCP_SECRET_KEY=

# Comma-separated AH account emails allowed to sign in (case-insensitive).
# EMPTY = ANY Albert Heijn account may sign in (a warning is logged).
# Removing an email revokes that person on their next request/refresh.
AH_MCP_ALLOWED_EMAILS=

# Refresh-token (session) lifetime, Go duration. Renewed on every refresh.
AH_MCP_SESSION_TTL=720h

# Port for everything (/mcp, /.well-known/*, /oauth/*, login proxy, /healthz).
AH_MCP_PORT=3000

# Bind address. Bare binary default: 127.0.0.1. The container image sets 0.0.0.0.
#AH_MCP_BIND=127.0.0.1

# true = same as --remote (bind 0.0.0.0).
AH_REMOTE=false

# Allowed browser Origins for /mcp, comma-separated. Default: the
# AH_MCP_BASE_URL origin + localhost variants + https://claude.ai.
# "*" disables the check. Requests without an Origin header always pass.
AH_MCP_ALLOWED_ORIGINS=

# CIDRs of reverse proxies whose X-Forwarded-For is trusted for rate limiting
# (e.g. the ingress pod CIDR). Empty = use the TCP peer address.
AH_MCP_TRUSTED_PROXIES=

# debug | info | warn | error
AH_LOG_LEVEL=info

# Only "nl" is supported.
AH_SITE=nl
